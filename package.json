{
  "name": "digiworku-commander",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:electron": "electron .",
    "build:exe": "npm run build && electron-builder --win --dir && node scripts/copy-dist-exe.cjs",
    "cap:sync": "npx cap sync",
    "build:apk": "npm run build && npx cap sync android && node scripts/build-apk.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.digiworku.commander",
    "productName": "DigiWorku Commander",
    "directories": {
      "output": "dist-package"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
